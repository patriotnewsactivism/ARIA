FROM node:22-slim AS builder

ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.5.2 --activate

COPY . .

RUN if [ -n "$VITE_API_BASE_URL" ]; then echo "VITE_API_BASE_URL=${VITE_API_BASE_URL}" > artifacts/aria/.env.production; fi

RUN pnpm install --frozen-lockfile

RUN pnpm --filter @workspace/aria build

FROM node:22-slim AS runner

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.5.2 --activate

COPY . .

RUN pnpm install --frozen-lockfile

COPY --from=builder /app/artifacts/aria/dist ./artifacts/aria/dist

WORKDIR /app/artifacts/aria

ENV PORT=8080
EXPOSE 8080

CMD ["pnpm", "run", "serve"]
